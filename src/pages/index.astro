---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";

const waNumber = "6281229000001";
const waMsg = encodeURIComponent("Halo IDA Studio, saya mau tanya jadwal foto 😊");
const waHref = `https://wa.me/${waNumber}?text=${waMsg}`;

const services = [
  { slug:"personal-portrait", title:"Personal Portrait", desc:"Potret karaktermu — clean, editorial, siap untuk profil & portfolio.", price:"Mulai 150K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/ida-studio-a3bb8.webp", tag:"Best Seller" },
  { slug:"bestie", title:"Bestie", desc:"Sesi seru bareng sahabat — candid, pose guide, banyak gaya.", price:"Mulai 199K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/ida-foto-5e052.webp", tag:null },
  { slug:"couple", title:"Couple", desc:"Romantis & effortless — prewed simpel hingga anniversary.", price:"Mulai 199K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/studio-foto-b2e8c.webp", tag:null },
  { slug:"maternity", title:"Maternity", desc:"Abadikan momen kehamilan dengan lighting lembut & anggun.", price:"Mulai 250K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/studio-foto-pulokulon-97cd4.webp", tag:null },
  { slug:"family", title:"Family", desc:"Hangat & timeless — untuk keluarga besar maupun inti.", price:"Mulai 250K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/ida-mangunrejo-d544f.webp", tag:"Ramai" },
  { slug:"toddler", title:"Toddler", desc:"Ekspresi lucu si kecil — sabar, playful, banyak kesabaran.", price:"Mulai 150K", image:"https://idastudio.web.id/wp-content/uploads/2025/04/ida-studio-8e230.webp", tag:null },
  { slug:"group", title:"Group", desc:"Teman kantor, komunitas, wisuda — muat 6–15 orang.", price:"Mulai 299K", image:"https://idastudio.web.id/wp-content/uploads/2024/12/ida-photography-644ab.webp", tag:null },
  { slug:"self-photo", title:"Self-Photo", desc:"Studio privat + remote — bebas gaya tanpa fotografer.", price:"Mulai 89K", image:"https://idastudio.web.id/wp-content/uploads/2025/01/ida-foto-7dfe6.webp", tag:"Privat" },
  { slug:"pasfoto", title:"Pasfoto", desc:"Standar nasional — background merah/biru, cetak kilat.", price:"Mulai 35K", image:"https://idastudio.web.id/wp-content/uploads/2025/12/ida-studio-2dd4f.webp", tag:null },
  { slug:"pasfoto-plus", title:"Pasfoto Plus", desc:"Retouch halus + cetak premium untuk lamaran & dokumen.", price:"Mulai 55K", image:"https://idastudio.web.id/wp-content/uploads/2025/12/studio-foto-1885a.webp", tag:null },
  { slug:"jasa-edit-foto", title:"Jasa Edit Foto", desc:"Retouch, ganti background, color grading — jadi siap posting.", price:"Mulai 25K", image:"https://idastudio.web.id/wp-content/uploads/2025/01/studio-foto-63343.webp", tag:null },
  { slug:"pasfoto-profil-kerja", title:"Pasfoto & Profil Kerja", desc:"LinkedIn-ready — formal, rapi, lighting studio.", price:"Mulai 75K", image:"https://idastudio.web.id/wp-content/uploads/2026/05/ida-studio-1126e.webp", tag:"Baru" },
];
---

<Base>
  <Nav />

  <!-- HERO -->
  <section class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-10">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 lg:gap-10 items-center">
      <!-- left copy -->
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-[#E8DDD3] bg-white px-3.5 py-1.5 text-[11px] font-semibold tracking-[0.14em] text-[#8A7E74]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C45A3C]"></span>
          GROBOGAN · MANGUNREJO / PULOKULON · BUKA 09:00–17:00
        </div>
        <h1 class="serif mt-5 text-[40px] sm:text-[52px] lg:text-[64px] font-bold leading-[0.92] tracking-[-0.03em]">
          One Click,<br/>
          <span class="serif-display italic font-normal text-[#C45A3C]">Thousands of</span><br/>
          Memories.
        </h1>
        <p class="mt-4 max-w-[52ch] text-[15.5px] leading-7 text-[#4A4540]">
          IDA Studio Foto bantu kamu abadikan momen yang tak terulang — dari pasfoto 5 menit sampai sesi keluarga yang hangat. Lighting studio, arahan pose, dan hasil jadi yang siap cetak & share.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-[#1A1A18] text-white px-6 py-3.5 text-[14px] font-semibold hover:bg-black transition">
            Booking via WhatsApp
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#layanan" class="inline-flex items-center gap-2 rounded-full bg-white border border-[#E8DDD3] px-6 py-3.5 text-[14px] font-semibold hover:border-[#1A1A18] transition">
            Lihat Paket & Harga
          </a>
          <span class="hidden sm:inline-flex items-center gap-2 text-[13px] text-[#6B6560] ml-1">
            <span class="flex -space-x-2">
              <img src="https://i.pravatar.cc/100?img=5" alt="" class="w-7 h-7 rounded-full border-2 border-[#FDF8F3] object-cover"/>
              <img src="https://i.pravatar.cc/100?img=8" alt="" class="w-7 h-7 rounded-full border-2 border-[#FDF8F3] object-cover"/>
              <img src="https://i.pravatar.cc/100?img=9" alt="" class="w-7 h-7 rounded-full border-2 border-[#FDF8F3] object-cover"/>
            </span>
            <span class="font-medium">4.9/5 dari 800+ sesi</span>
            <span class="text-[#C9B8A8]">·</span>
            <span>Google Review</span>
          </span>
        </div>

        <div class="mt-5 flex flex-wrap gap-2 text-[12px] font-medium text-[#6B6560]">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white border border-[#E8DDD3] px-3 py-1.5">✓ Tanpa perlu bawa properti</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white border border-[#E8DDD3] px-3 py-1.5">✓ File + cetak hari itu</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white border border-[#E8DDD3] px-3 py-1.5">✓ Bisa reschedule H-1</span>
        </div>
      </div>

      <!-- right bento -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <div class="space-y-3 sm:space-y-4">
          <div class="rounded-[22px] overflow-hidden bg-white border border-[#E8DDD3] p-2 shadow-[0_12px_32px_rgba(26,26,24,0.08)]">
            <img src="https://idastudio.web.id/wp-content/uploads/2024/12/ida-mangunrejo-d544f.webp" alt="Family portrait" class="w-full aspect-[4/5] object-cover rounded-[16px]" loading="eager" />
            <div class="px-2 pt-2.5 pb-1 flex items-center justify-between">
              <span class="text-[13px] font-semibold">Family Session</span>
              <span class="text-[11px] font-semibold tracking-widest bg-[#FDF0E8] text-[#C45A3C] px-2 py-1 rounded-full">POPULER</span>
            </div>
          </div>
          <div class="rounded-[22px] overflow-hidden bg-[#1A1A18] text-white p-5 sm:p-6">
            <div class="text-[11px] tracking-[0.14em] text-white/60 font-semibold">SELF-PHOTO BOOTH</div>
            <div class="serif text-[22px] leading-none mt-1">Privasi penuh.<br/><span class="serif-display italic font-normal text-[#F2C6B2]">Kamu yang pegang remote.</span></div>
            <div class="mt-3 text-[12.5px] text-white/70 leading-5">15 menit / sesi · 89K · Bebas pose sepuasnya</div>
            <a href="#harga" class="mt-4 inline-flex text-[13px] font-semibold text-white underline underline-offset-4 decoration-white/30 hover:decoration-white">Lihat slot hari ini →</a>
          </div>
        </div>
        <div class="space-y-3 sm:space-y-4 pt-6">
          <div class="rounded-[22px] overflow-hidden bg-white border border-[#E8DDD3] p-2 shadow-[0_12px_32px_rgba(26,26,24,0.08)]">
            <img src="https://idastudio.web.id/wp-content/uploads/2024/12/ida-studio-a3bb8.webp" alt="Personal portrait" class="w-full aspect-[4/5] object-cover rounded-[16px]" loading="eager" />
            <div class="px-2 pt-2.5 pb-1">
              <div class="text-[13px] font-semibold">Personal Portrait</div>
              <div class="text-[12px] text-[#6B6560]">Editorial · siap untuk profil kerja</div>
            </div>
          </div>
          <div class="rounded-[22px] overflow-hidden relative">
            <img src="https://idastudio.web.id/wp-content/uploads/2024/12/studio-foto-b2e8c.webp" alt="Couple" class="w-full aspect-[4/3] object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 p-4 text-white">
              <div class="text-[12px] tracking-widest font-semibold text-white/80">COUPLE & PREWED</div>
              <div class="serif text-[18px] leading-none">Cinta yang difoto, bukan dipaksa.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- trust strip -->
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="rounded-2xl bg-white border border-[#E8DDD3] px-4 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#FDF0E8] grid place-items-center text-[#C45A3C]">✦</div>
        <div><div class="text-[18px] font-bold leading-none">800+</div><div class="text-[12px] text-[#6B6560]">sesi / tahun</div></div>
      </div>
      <div class="rounded-2xl bg-white border border-[#E8DDD3] px-4 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#FDF0E8] grid place-items-center text-[#C45A3C]">★</div>
        <div><div class="text-[18px] font-bold leading-none">4.9 / 5.0</div><div class="text-[12px] text-[#6B6560]">rating pelanggan</div></div>
      </div>
      <div class="rounded-2xl bg-white border border-[#E8DDD3] px-4 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#FDF0E8] grid place-items-center text-[#C45A3C]">◷</div>
        <div><div class="text-[18px] font-bold leading-none">7+ tahun</div><div class="text-[12px] text-[#6B6560]">di Grobogan</div></div>
      </div>
      <div class="rounded-2xl bg-white border border-[#E8DDD3] px-4 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#FDF0E8] grid place-items-center text-[#C45A3C]">◈</div>
        <div><div class="text-[18px] font-bold leading-none">12 layanan</div><div class="text-[12px] text-[#6B6560]">siap pilih</div></div>
      </div>
    </div>
  </section>

  <!-- LAYANAN -->
  <section id="layanan" class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pt-6 pb-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="text-[11px] tracking-[0.16em] font-semibold text-[#C45A3C]">LAYANAN KAMI</div>
        <h2 class="serif text-[30px] sm:text-[36px] font-bold leading-none mt-1">Pilih ceritamu.</h2>
        <p class="text-[14px] text-[#6B6560] mt-2 max-w-[58ch]">Semua sesi sudah termasuk arahan pose, pilihan background, dan file digital. Tinggal datang — kami yang atur sisanya.</p>
      </div>
      <a href={waHref} target="_blank" class="hidden sm:inline-flex text-[13px] font-semibold underline underline-offset-4 decoration-[#C45A3C]/30 hover:decoration-[#C45A3C]">Konsultasi gratis di WhatsApp →</a>
    </div>

    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
      {services.map(s => (
        <a href={`#${s.slug}`} class="group rounded-[20px] overflow-hidden bg-white border border-[#E8DDD3] hover:border-[#D9C7B6] hover:shadow-[0_12px_32px_rgba(26,26,24,0.08)] transition flex flex-col">
          <div class="relative">
            <img src={s.image} alt={s.title} class="w-full aspect-[4/3] object-cover group-hover:scale-[1.02] transition duration-500" loading="lazy" />
            {s.tag && <span class="absolute left-3 top-3 text-[10px] font-bold tracking-widest bg-[#1A1A18] text-white px-2.5 py-1 rounded-full">{s.tag}</span>}
            <span class="absolute right-3 bottom-3 text-[11px] font-semibold bg-white/90 backdrop-blur px-2.5 py-1 rounded-full border border-[#E8DDD3]">{s.price}</span>
          </div>
          <div class="p-4 flex flex-col flex-1">
            <div class="text-[15px] font-semibold leading-tight">{s.title}</div>
            <div class="text-[13px] leading-5 text-[#6B6560] mt-1 line-clamp-2">{s.desc}</div>
            <div class="mt-3 text-[13px] font-semibold text-[#C45A3C] group-hover:text-[#A84A30]">Lihat contoh →</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- SELF PHOTO SPOTLIGHT -->
  <section class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pb-10">
    <div class="rounded-[28px] overflow-hidden bg-[#1A1A18] text-white grid lg:grid-cols-[1.05fr_0.95fr]">
      <div class="p-6 sm:p-8 lg:p-10">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1.5 text-[11px] font-semibold tracking-[0.14em]">SELF-PHOTO STUDIO · PRIVAT 100%</div>
        <h3 class="serif text-[30px] sm:text-[36px] font-bold leading-[0.95] mt-4">Foto tanpa<br/><span class="serif-display italic font-normal text-[#F2C6B2]">rasa canggung.</span></h3>
        <p class="mt-3 text-[14px] leading-6 text-white/70 max-w-[44ch]">Masuk berdua atau rame-rame, tekan remote, gaya bebas. Layar preview besar + lampu studio sudah siap. Cocok untuk bestie, couple, dan keluarga yang mau candid natural.</p>
        <ul class="mt-5 space-y-2 text-[13.5px] text-white/85">
          <li class="flex gap-2"><span class="text-[#F2C6B2]">—</span> 15 / 25 / 40 menit · file langsung jadi</li>
          <li class="flex gap-2"><span class="text-[#F2C6B2]">—</span> Bebas bawa properti & outfit ganti</li>
          <li class="flex gap-2"><span class="text-[#F2C6B2]">—</span> Hasil softcopy + cetak 4R pilihan</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={waHref} target="_blank" class="inline-flex items-center gap-2 rounded-full bg-white text-[#1A1A18] px-5 py-3 text-[13.5px] font-semibold hover:bg-[#FDF8F3] transition">Booking Self-Photo</a>
          <span class="inline-flex items-center rounded-full border border-white/15 px-4 py-3 text-[13px] font-medium text-white/80">Mulai 89K / sesi</span>
        </div>
      </div>
      <div class="relative min-h-[320px] lg:min-h-0">
        <img src="https://idastudio.web.id/wp-content/uploads/2025/01/ida-foto-7dfe6.webp" alt="Self photo" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent lg:bg-gradient-to-r lg:from-[#1A1A18] lg:via-transparent lg:to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 lg:bottom-6 lg:left-6 lg:right-auto flex gap-2">
          <span class="rounded-full bg-white text-[#1A1A18] px-3 py-1.5 text-[12px] font-semibold">15 menit · 89K</span>
          <span class="rounded-full bg-[#C45A3C] text-white px-3 py-1.5 text-[12px] font-semibold">Paling laris</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HARGA -->
  <section id="harga" class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pb-10">
    <div class="text-center max-w-2xl mx-auto">
      <div class="text-[11px] tracking-[0.16em] font-semibold text-[#C45A3C]">PAKET & HARGA</div>
      <h2 class="serif text-[30px] sm:text-[38px] font-bold leading-none mt-1">Transparan. Tanpa biaya kejutan.</h2>
      <p class="text-[14px] text-[#6B6560] mt-2">Semua paket sudah termasuk file digital. Cetak & bingkai bisa tambah sesuai kebutuhan.</p>
    </div>

    <div class="mt-8 grid lg:grid-cols-3 gap-4 sm:gap-5">
      <!-- Starter -->
      <div class="rounded-[24px] bg-white border border-[#E8DDD3] p-6 sm:p-7 flex flex-col">
        <div class="text-[11px] tracking-[0.14em] font-semibold text-[#8A7E74]">STARTER</div>
        <div class="serif text-[28px] font-bold leading-none mt-1">Pasfoto & Self</div>
        <div class="text-[13px] text-[#6B6560] mt-1">Kilat, rapi, siap dokumen.</div>
        <div class="mt-5 flex items-baseline gap-2"><span class="text-[30px] font-bold tracking-tight">35K</span><span class="text-[13px] text-[#6B6560]">/ mulai</span></div>
        <ul class="mt-5 space-y-2.5 text-[13.5px] leading-5 text-[#2B2B28]">
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> Pasfoto merah/biru 2×3–4×6</li>
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> Self-photo 15 menit + softcopy</li>
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> Cetak kilat 10–15 menit</li>
          <li class="flex gap-2 text-[#6B6560]"><span>—</span> Retouch halus (tambah 15K)</li>
        </ul>
        <a href={waHref} target="_blank" class="mt-6 inline-flex justify-center rounded-full border border-[#1A1A18] px-5 py-3 text-[13.5px] font-semibold hover:bg-[#1A1A18] hover:text-white transition">Pilih Starter</a>
      </div>

      <!-- Popular -->
      <div class="rounded-[24px] bg-[#1A1A18] text-white p-6 sm:p-7 flex flex-col relative overflow-hidden border border-[#1A1A18]">
        <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-[#C45A3C]/20 blur-2xl"></div>
        <div class="inline-flex self-start rounded-full bg-[#C45A3C] px-3 py-1 text-[11px] font-bold tracking-widest">PALING DIPILIH</div>
        <div class="serif text-[28px] font-bold leading-none mt-3">Portrait & Family</div>
        <div class="text-[13px] text-white/65 mt-1">Untuk momen yang ingin diingat lama.</div>
        <div class="mt-5 flex items-baseline gap-2"><span class="text-[30px] font-bold tracking-tight">199K</span><span class="text-[13px] text-white/60">/ sesi 30 menit</span></div>
        <ul class="mt-5 space-y-2.5 text-[13.5px] leading-5 text-white/90">
          <li class="flex gap-2"><span class="text-[#F2C6B2]">✓</span> 15–25 file edit + semua file ori</li>
          <li class="flex gap-2"><span class="text-[#F2C6B2]">✓</span> 2 background + arahan pose</li>
          <li class="flex gap-2"><span class="text-[#F2C6B2]">✓</span> 1 cetak 10R + softcopy Google Drive</li>
          <li class="flex gap-2"><span class="text-[#F2C6B2]">✓</span> Outfit ganti (1×)</li>
        </ul>
        <a href={waHref} target="_blank" class="mt-6 inline-flex justify-center rounded-full bg-white text-[#1A1A18] px-5 py-3 text-[13.5px] font-semibold hover:bg-[#FDF8F3] transition">Booking 199K</a>
        <div class="mt-3 text-center text-[11px] tracking-wide text-white/55">Slot weekend cepat penuh — booking H-2 disarankan</div>
      </div>

      <!-- Atelier -->
      <div class="rounded-[24px] bg-white border border-[#E8DDD3] p-6 sm:p-7 flex flex-col">
        <div class="text-[11px] tracking-[0.14em] font-semibold text-[#8A7E74]">ATELIER</div>
        <div class="serif text-[28px] font-bold leading-none mt-1">Maternity & Group</div>
        <div class="text-[13px] text-[#6B6560] mt-1">Konsep matang, lighting editorial.</div>
        <div class="mt-5 flex items-baseline gap-2"><span class="text-[30px] font-bold tracking-tight">399K</span><span class="text-[13px] text-[#6B6560]">/ sesi 60 menit</span></div>
        <ul class="mt-5 space-y-2.5 text-[13.5px] leading-5 text-[#2B2B28]">
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> 30+ file edit + konsep custom</li>
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> Properti studio & fabric</li>
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> 2 cetak 10R + 1 bingkai 12R</li>
          <li class="flex gap-2"><span class="text-[#C45A3C]">✓</span> Jasa edit lanjutan included</li>
        </ul>
        <a href={waHref} target="_blank" class="mt-6 inline-flex justify-center rounded-full border border-[#1A1A18] px-5 py-3 text-[13.5px] font-semibold hover:bg-[#1A1A18] hover:text-white transition">Konsultasi Atelier</a>
      </div>
    </div>
    <p class="text-center text-[12px] text-[#8A7E74] mt-4">Harga dapat berubah saat promo. Tanya admin untuk price list PDF terbaru.</p>
  </section>

  <!-- GALERI -->
  <section id="galeri" class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pb-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <div class="text-[11px] tracking-[0.16em] font-semibold text-[#C45A3C]">GALERI</div>
        <h2 class="serif text-[28px] sm:text-[34px] font-bold leading-none mt-1">Hasil yang bicara.</h2>
      </div>
      <a href="https://idastudio.web.id" target="_blank" class="text-[13px] font-semibold text-[#6B6560] hover:text-[#1A1A18] hidden sm:inline">Lihat semua di web lama →</a>
    </div>
    <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
